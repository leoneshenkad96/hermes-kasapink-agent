# Copy to a local .env file. Never commit the filled file.

# ERP read-only API. Password is a local secret; never commit the filled file.
KASAPINK_BASE_URL=https://erp.kasapink.com
KASAPINK_USERNAME=hermes-monitor
KASAPINK_PASSWORD=
KASAPINK_OPERATOR_USERNAME=hermes-operator
KASAPINK_OPERATOR_PASSWORD=
# Optional overrides; defaults are /api/healthz and /api/erp/state.
KASAPINK_HEALTH_URL=
KASAPINK_STATE_URL=
# Legacy health-only mode (omit KASAPINK_BASE_URL to use it).
KASAPINK_BEARER_TOKEN=

# MikroTik RouterOS REST base URL, for example https://192.0.2.1/rest
MIKROTIK_API_URL=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_VERIFY_TLS=true
# Optional CA certificate path for RouterOS API-SSL; certificate validation stays enabled.
MIKROTIK_TLS_CA_FILE=
# Optional RouterOS API probe over the Hermes WireGuard tunnel.
MIKROTIK_HOST=10.10.10.1
MIKROTIK_API_PORT=8728
MIKROTIK_API_TLS=false
MIKROTIK_CORE_HOST=10.10.10.1
MIKROTIK_CORE_PORT=8728
MIKROTIK_CORE_TLS=false
MIKROTIK_LAN_HOST=192.168.80.1
MIKROTIK_LAN_PORT=8728
MIKROTIK_LAN_TLS=false

# Local state file. Keep it outside source control if it contains sensitive data.
MONITOR_STATE_FILE=./data/baseline.json
HERMES_HISTORY_DB=./data/history.db
HERMES_HISTORY_RETENTION_DAYS=90
HERMES_MEMORY_DB=./data/memory.db
# Short-term context is clamped safely to 10–20 messages.
HERMES_SHORT_TERM_MESSAGES=20
# Create one durable conversation summary after this many natural-chat turns.
HERMES_MEMORY_SUMMARY_EVERY_TURNS=20
HERMES_STOCK_DROP_RATIO=0.5
HERMES_PRICE_CHANGE_RATIO=0.2
HERMES_APPROVAL_FILE=./data/pending-approvals.json
HERMES_APPROVAL_TTL_MINUTES=10
# Auto ERP only accepts complete, same-day, low-value, unambiguous entries.
HERMES_ERP_AUTO_ENABLED=true
HERMES_ERP_AUTO_MAX_VALUE=100000
HERMES_LOCAL_ACTIONS_ENABLED=true
HERMES_LOCAL_KILL_SWITCH=./data/LOCAL_ACTIONS_DISABLED

# Optional model keys for Hermes/provider setup; do not put them in prompts.
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
BRAVE_SEARCH_API_KEY=

# Discord bot. Keep the token secret; channel/server IDs are not secrets.
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL=
DISCORD_COMMAND_CHANNEL=
DISCORD_GUILD_ID=
KASAPINK_REPO_ROOT=
# Required: the bot fails to start when this owner Discord user ID is blank.
DISCORD_ALLOWED_USER_ID=
# Additional people allowed to use non-MikroTik Hermes features; MikroTik stays owner-only.
DISCORD_ADDITIONAL_USER_IDS=
# Privileged actions are owner-only unless specific IDs are explicitly added.
DISCORD_ERP_OPERATOR_IDS=
DISCORD_LOCAL_ACTION_OPERATOR_IDS=
# Optional friendly labels. JSON or semicolon format: {"DISCORD_USER_ID":"Hensa"}
HERMES_USER_NAMES=
MONITOR_INTERVAL_MINUTES=30
HERMES_GET_RETRIES=3
HERMES_ALERT_COOLDOWN_MINUTES=180
HERMES_ALERTS_ENABLED=true
HERMES_IDLE_ALERT_MINUTES=180

# Daily Discord digest at 06:00 Asia/Jakarta (sent to DISCORD_ALERT_CHANNEL).
HERMES_DAILY_REPORT_STATE=./data/daily-report.json
HERMES_STOCK_REPORT_STATE=./data/stock-report.json

# Optional read-only Indonesian stock daily history. Free tier: 500 API hits/month.
# Create a key in Api.co.id dashboard and keep the real value only in local .env.
API_CO_ID_KEY=
# Optional separate Discord channel for the 06:00 WIB stock digest, e.g. #hermes-saham ID.
DISCORD_STOCK_CHANNEL=
# Optional fixed watchlist. Leave empty to choose random IDX instruments each day.
HERMES_STOCK_WATCHLIST=

# Optional external DevOps integrations. Keep real values only in the local
# secret store/.env; Hermes never prints them. Start read-only and scope to
# the intended account/project/repository before enabling write workflows.
GITHUB_TOKEN=
GH_TOKEN=
VERCEL_TOKEN=
NEON_API_KEY=
HERMES_GITHUB_REPOSITORY=leoneshenkad96/kasapink
HERMES_VERCEL_PROJECT=kasapink-erp
NEON_PROFILE=kasapink
NEON_ORG_ID=org-muddy-paper-34859451
NEON_PROJECT_ID=calm-frog-60149804
# Daily random sample size when no fixed watchlist is configured (default 5).
HERMES_STOCK_RANDOM_COUNT=5
# Optional comma-separated watchlist for the daily digest; max 5 symbols.
HERMES_STOCK_WATCHLIST=

# Optional FREE-TIER multi-provider router (Discord chat only).
# OFF by default: existing Groq primary / Gemini fallback stay unchanged.
HERMES_MULTI_PROVIDER_ENABLED=false
HERMES_MULTI_PROVIDER_TASK_ROUTING=false
# Explicitly allow chat/context to flow to NEW cloud vendors only after reviewing data policies.
HERMES_NEW_CLOUD_DATA_ALLOWED=false
HERMES_PROVIDER_USAGE_FILE=./data/provider-usage.json
# OpenRouter: select a current model ID ending in :free (never a paid model).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Cerebras: verify the account is on $0 Free tier and choose available model.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_FREE_TIER_CONFIRMED=false
# Cloudflare Workers AI: confirm Workers FREE plan; paid-only models are blocked.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
# Ollama: local model only, listening on 127.0.0.1:11434.
HERMES_OLLAMA_ENABLED=false
OLLAMA_MODEL=
